# ─── Backend (Vercel / local) ───────────────────────────────────────────────

# Puerto para desarrollo local (Vercel lo ignora en prod)
PORT=3000

# Origen(es) permitido(s) por CORS — el dominio de Firebase Hosting en prod.
# Coma-separado. En dev incluye el de Vite.
CORS_ORIGIN=http://localhost:5173

# ─── Firebase Admin (service account) ───────────────────────────────────────
# En LOCAL: ruta a un archivo JSON de service account (descárgalo de
#   Firebase Console → Configuración del proyecto → Cuentas de servicio).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
#
# En VERCEL: NO subas el archivo. Pega el JSON completo (en una línea) en esta var:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

FIREBASE_PROJECT_ID=cnb-test-61a1a

# ─── Admin allowlist (auth solo-admin) ──────────────────────────────────────
# Correos (coma-separado) autorizados a usar /api/admin/* y mutaciones.
ADMIN_EMAILS=tu_correo@ejemplo.com

# ─── Ingesta ────────────────────────────────────────────────────────────────
# Ruta al dump JSONL de la raíz del proyecto de auditoría.
JSONL_PATH=../../cn_control2/contenido_paginas.jsonl
# Clasificador de spam (opcional): ruta a hallazgos.json
HALLAZGOS_PATH=../../cn_control2/hallazgos.json
# Tamaño de lote de escritura a Firestore (máx 500)
INGEST_BATCH_SIZE=500
